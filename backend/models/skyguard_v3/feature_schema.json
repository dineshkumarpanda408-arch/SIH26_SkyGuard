    "pressure_volatility",
    "humidity_change",
    "humidity_rolling_mean",
    "humidity_rolling_std",
    "humidity_roc",
    "humidity_volatility"
  ],
  "ml_feature_sets": {
    "baseline": [
      "temperature",
      "pressure",
      "humidity"
    ],
    "temporal": [
      "hour",
      "temperature",
      "temperature_change",
      "temperature_rolling_mean",
      "temperature_rolling_std",
      "temperature_roc",
      "pressure",
      "pressure_change",
      "humidity",
      "humidity_change"
    ],
    "multivariate": [
      "dew_point",
      "vapor_pressure_sat",
      "mixing_ratio",
      "delta_t",
      "delta_p",
      "humidity_change"
    ],
    "seasonal": "cyclic hour-of-day + raw vars"
  },
  "ml_hyperparameters": {
    "baseline": {
      "n_estimators": 100,
      "max_samples": "auto",
      "max_features": 1.0,
      "contamination": 0.05,
      "random_state": 42,
      "feature_names": [
        "temperature",
        "pressure",
        "humidity"
      ],
      "features_standardized_by": "StandardScaler (fit on TRAIN only)",
      "decision_to_score": "anchored sigmoid of standardized decision function (uncalibrated)"
    },
    "temporal": {
      "n_estimators": 100,
      "max_samples": "auto",
      "max_features": 1.0,
      "contamination": 0.04,
      "random_state": 7,
      "feature_names": [
        "hour",
        "temperature",
        "temperature_change",
        "temperature_rolling_mean",
        "temperature_rolling_std",
        "temperature_roc",
        "pressure",
        "pressure_change",
        "humidity",
        "humidity_change"
      ],
      "features_standardized_by": "StandardScaler (fit on TRAIN only)",
      "decision_to_score": "anchored sigmoid of standardized decision function (uncalibrated)"
    },
    "multivariate": {
      "n_estimators": 100,
      "max_samples": "auto",
      "max_features": 1.0,
      "contamination": 0.04,
      "random_state": 21,
      "feature_names": [
        "dew_point",
        "vapor_pressure_sat",
        "mixing_ratio",
        "delta_t",
        "delta_p",
        "humidity_change"
      ],
      "features_standardized_by": "StandardScaler (fit on TRAIN only)",
      "decision_to_score": "anchored sigmoid of standardized decision function (uncalibrated)"
    },
    "seasonal": "SeasonalDetector (diurnal profile residuals; no sklearn RandomState used)"
  },
  "channel_features": {
    "drift": "residual = observed - train-hour-of-day expectation; robust slope + EWMA + CUSUM + persistence",
    "flatline": "roll-std vs train baseline + zero-diff ratio + unique-value count + plateau persistence",
    "missingness": "RAW pre-impute: NaN/invalid runs, per-var missingness, trailing fraction, timestamp gaps",
    "roc": "dedicated SPIKE/DROP rate-of-change: first-difference |x[t]-x[t-1]| per var normalised by train typical step magnitude; causal, 0 on frozen/missing rows"
  },
  "detector_parameters": {
    "drift": {
      "ewma_alpha": 0.4,
      "cusum_k": 0.55,
      "cusum_h": 3.0,
      "slope_win": 8,
      "epsilon": 1e-06
    },
    "flatline": {
      "window": 5,
      "ratio_floor": 0.4,
      "eps": 1e-09
    },
    "missingness": {
      "interval_tol_fraction": 1.5,
      "window": 12,
      "eps": 1e-09
    },
    "roc": {
      "lo": 5.0,
      "hi": 10.0,
      "eps": 1e-06
    }
  },
  "grouping": "per-station feature engineering to avoid cross-station bleed"
}